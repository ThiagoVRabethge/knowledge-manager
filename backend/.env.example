# Database (Neon PostgreSQL em produção, SQLite em dev)
# Exemplo Neon: postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///./knowledge.db

# JWT
SECRET_KEY=change-me-to-a-very-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI - Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash-latest

# CORS - múltiplas origens separadas por vírgula
# Exemplo: https://knowledge-frontend.onrender.com,https://app.seudominio.com
CORS_ORIGINS=http://localhost:5173